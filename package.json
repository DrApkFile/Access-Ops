{
  "name": "template",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/node": "^24",
    "@modelcontextprotocol/sdk": "1.32.2",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.14",
    "ip-address": "10.7.4",
    "js-yaml": "4.3.2",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "uuid": "11.1.1",
    "zod": "4.6.7",
    "@esbuild-kit/esm-loader": "npm:tsx@4.23.12"
  },
  "scripts": {
    "setup": "bash scripts/init.sh",
    "dev": "bun scripts/dev.ts",
    "build": "bun run --workspaces --if-present build",
    "lint": "bun run --workspaces --if-present lint",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun test packages/floor-model packages/accessops apps/api/src apps/web/src",
    "test:integration": "bun --env-file=apps/api/.env test tests/integration/accessops.test.ts && bun --env-file=apps/api/.env test tests/integration/geometry-review.test.ts",
    "worker": "bun run --cwd apps/api src/worker.ts",
    "demo": "bun run --cwd apps/api scripts/accessops-demo.ts",
    "security": "bun scripts/security-check.ts",
    "benchmark:geometry": "bun --env-file=apps/api/.env apps/api/scripts/geometry-benchmark/run.ts",
    "demo:geometry": "bun --env-file=apps/api/.env apps/api/scripts/geometry-benchmark/demo-evidence.ts"
  }
}
