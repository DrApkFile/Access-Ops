# Bun 1.3.14. API variables go in apps/api/.env. Never commit secrets.
DATABASE_URL=
PORT=3003
UPLOADS_DIR=data/uploads
ACCESSOPS_AUTH_MODE=session
ACCESSOPS_ALLOWED_ORIGINS=http://localhost:3000
ACCESSOPS_PERSISTENT_STORAGE=false
# auto prefers deliberately configured Meterless Runtime; nvidia/meterless pin one provider.
ACCESSOPS_EXPLANATION_PROVIDER=auto
# An automatic NVIDIA fallback requires BOTH this opt-in and the explicit text-workspace list.
ACCESSOPS_NVIDIA_FALLBACK=true
ACCESSOPS_NVIDIA_TEXT_WORKSPACES=
# Comma-separated workspace IDs explicitly permitted to send evidence to providers:
ACCESSOPS_PROVIDER_WORKSPACES=
# NVIDIA remains the text provider for existing edit/layout and investigation tasks.
MODEL_PROVIDER=nvidia
# Image inference is independent of NVIDIA text. No automatic provider fallback.
VISION_PROVIDER=openrouter
# This exact :free model only; account/catalog and zero-price routing are checked before inference.
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=
ACCESSOPS_OPENROUTER_VISION_WORKSPACES=
OPENROUTER_VISION_MAX_OUTPUT_TOKENS=8192
# Optional original Gemini image path, selected only with VISION_PROVIDER=gemini.
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
# True ONLY after confirming this key belongs to a project without active billing.
GEMINI_FREE_TIER_CONFIRMED=false
# Explicitly approved workspaces; free service is for public/synthetic, nonconfidential input.
ACCESSOPS_GEMINI_VISION_WORKSPACES=
GEMINI_VISION_MAX_OUTPUT_TOKENS=8192
# Meterless Runtime 0.90.0 contract: use the real runtime token, never rt-local.
# Leave blank until you have an actual authorized Runtime origin.
# A local installation commonly uses http://127.0.0.1:8088/v1; no implicit probe is made.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# Explicit model identity; availability checked through configured service /models.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Explicit opt-in: ordinary investigations remain deterministic by default.
ACCESSOPS_AUTO_EXPLANATION=false
# Optional absolute path to authorized server integration env; never sent to the browser.
ACCESSOPS_INTEGRATION_ENV_FILE=
# Optional private diagnostics directory (contains authorized source-derived text).
ACCESSOPS_PROVIDER_EVIDENCE_DIR=
# Catalog advertised Free Endpoint Available at verification; verify account terms/availability.
MODEL_CRITICAL=gemini-3.6-flash
MODEL_COMPARE=gemini-3.6-flash
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_LAYOUT=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_MAX_OUTPUT_TOKENS=8192
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_QUERY_PROTOCOL=query-start
# Optional authorized credentials file; values stay server-side.
ZETARIS_CREDENTIALS_FILE=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_WORKSPACE_ID=
ZETARIS_DIRECTORY_TABLE=
ZETARIS_OPERATIONS_TABLE=
ZETARIS_SOURCE_ALLOWED_HOSTS=
# Web-only variables in apps/web/.env.local:
# API_INTERNAL_URL=http://localhost:3003
